<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48 on purpose, following OmniSimCOMProxy from the official
      ASCOM.Alpaca.Simulators repo. Verified: ASCOM.Alpaca.Components 3.1.0
      publishes netstandard2.0, which net48 consumes, so this shim can
      use the official Alpaca client without reimplementing anything.

      Only builds on Windows. Linux uses OnStepX.CrossPlatform.slnf,
      which excludes this project.
    -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>OnStepX.ComShim</RootNamespace>
    <AssemblyName>OnStepX.ComShim</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ComVisible>false</ComVisible>
    <Description>Local Server COM that exposes the Alpaca server's OnStepX devices to COM-only clients. It does not talk to the mount: it is a localhost Alpaca client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ASCOM.Alpaca.Components" Version="3.1.0" />
    <PackageReference Include="ASCOM.Com.Components" Version="3.1.0" />
    <PackageReference Include="ASCOM.Common.Components" Version="3.1.0" />
    <PackageReference Include="ASCOM.DeviceInterfaces" Version="7.1.2" />
    <PackageReference Include="ASCOM.Exception.Library" Version="7.1.2" />
    <PackageReference Include="ASCOM.Tools" Version="3.1.0" />
  </ItemGroup>

</Project>
