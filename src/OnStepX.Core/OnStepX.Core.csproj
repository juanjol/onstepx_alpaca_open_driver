<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OnStepX.Core</RootNamespace>
    <Description>OnStepX's extended LX200 protocol, transports, port autodiscovery and device controllers. No dependencies on ASCOM.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serie multiplataforma: COMn en Windows, /dev/tty* en Linux. -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The tests need to see some internals, in particular the autodiscovery
      response validators, which are an implementation detail but are worth
      testing separately because they are what avoids false positives.
    -->
    <InternalsVisibleTo Include="OnStepX.Core.Tests" />
  </ItemGroup>

</Project>
