@*
    A card holding values that live in the controller rather than in the driver settings
    file.

    It exists to make that distinction impossible to miss. Everything inside is read from
    and written to the mount, so it needs the controller reachable, it takes effect
    immediately, and it survives reinstalling the driver. The driver's own settings are
    edited in the plain cards and only take effect when saved.
*@

<section class="card">
    <div class="card-head">
        <div>
            <h2>@Title</h2>
            @if (Description is not null)
            {
                <p>@Description</p>
            }
        </div>
        <div class="actions actions-inline">
            @if (Actions is not null)
            {
                @Actions
            }
        </div>
    </div>

    @if (!Loaded)
    {
        <p class="muted">
            @(Busy ? "Reading from the controller..." : NotLoadedText)
        </p>
    }
    else
    {
        @ChildContent
    }
</section>

@code {
    /// <summary>Section title.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>What this section covers.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>The values have been read from the controller.</summary>
    [Parameter]
    public bool Loaded { get; set; }

    /// <summary>A read or a write is under way.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Text shown before anything has been read.</summary>
    [Parameter]
    public string NotLoadedText { get; set; } =
        "Not read yet. Use Read from controller above.";

    /// <summary>Buttons for the header.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>The fields.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
