<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OnStepX.AlpacaServer</RootNamespace>
    <AssemblyName>OnStepX.AlpacaServer</AssemblyName>
    <OutputType>Exe</OutputType>
    <UserSecretsId>onstepx-alpaca-server</UserSecretsId>
    <Description>Servidor ASCOM Alpaca para OnStepX: API REST, descubrimiento UDP y UI de configuracion en Blazor.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ASCOM.Alpaca.Razor aporta toda la superficie REST de Alpaca
      (TelescopeController, FocuserController, RotatorController,
      ObservingConditionsController), el ManagementController, el
      DiscoveryManager UDP y el DeviceManager de registro.

      Version fijada a proposito: este paquete NO tiene release estable,
      solo 0.5.0-alpha02 y 0.6.0-alpha02. Depende de librerias estables
      (ASCOM.Alpaca.Device 3.0.0, ASCOM.Common.Components 3.0.0,
      ASCOM.Exception.Library 7.1.2, ASCOM.Tools 3.0.0) y lo mantiene el
      propio ASCOM Initiative, que lo usa en ASCOM.Alpaca.Simulators.
      No actualizar sin comprobar antes que ConformU sigue pasando.
    -->
    <PackageReference Include="ASCOM.Alpaca.Razor" Version="0.6.0-alpha02" />
    <PackageReference Include="ASCOM.Alpaca.Device" Version="3.1.0" />
    <PackageReference Include="ASCOM.Common.Components" Version="3.1.0" />
    <PackageReference Include="ASCOM.Tools" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Alojamiento como servicio. El mismo ejecutable sirve para consola, bandeja,
      servicio de Windows y unidad systemd, seleccionable en el instalador.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnStepX.Core\OnStepX.Core.csproj" />
    <ProjectReference Include="..\OnStepX.Devices\OnStepX.Devices.csproj" />
  </ItemGroup>

</Project>
