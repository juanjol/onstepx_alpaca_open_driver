<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OnStepX.AlpacaServer</RootNamespace>
    <AssemblyName>OnStepX.AlpacaServer</AssemblyName>
    <OutputType>Exe</OutputType>
    <UserSecretsId>onstepx-alpaca-server</UserSecretsId>
    <Description>ASCOM Alpaca server for OnStepX: REST API, UDP discovery and Blazor configuration UI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ASCOM.Alpaca.Razor provides the whole Alpaca REST surface
      (TelescopeController, FocuserController, RotatorController,
      ObservingConditionsController), the ManagementController, the
      UDP DiscoveryManager and the registration DeviceManager.

      Version pinned on purpose: this package has NO stable release,
      only 0.5.0-alpha02 and 0.6.0-alpha02. It depends on stable
      libraries (ASCOM.Alpaca.Device 3.0.0, ASCOM.Common.Components 3.0.0,
      ASCOM.Exception.Library 7.1.2, ASCOM.Tools 3.0.0) and is maintained by
      the ASCOM Initiative itself, which uses it in ASCOM.Alpaca.Simulators.
      Do not update without first checking that ConformU still passes.
    -->
    <PackageReference Include="ASCOM.Alpaca.Razor" Version="0.6.0-alpha02" />
    <PackageReference Include="ASCOM.Alpaca.Device" Version="3.1.0" />
    <PackageReference Include="ASCOM.Common.Components" Version="3.1.0" />
    <PackageReference Include="ASCOM.Tools" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Hosting as a service. The same executable serves as console, tray,
      Windows service and systemd unit, selectable in the installer.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnStepX.Core\OnStepX.Core.csproj" />
    <ProjectReference Include="..\OnStepX.Devices\OnStepX.Devices.csproj" />
  </ItemGroup>

</Project>
